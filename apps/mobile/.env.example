# Copy to apps/mobile/.env and fill in. Only EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here (service role key etc. belong in Supabase / server env only).
#
# Local dev: run `pnpm db:start` from the repo root and copy the API URL + anon/publishable key.
# On a physical phone, replace 127.0.0.1 with your computer's LAN IP (e.g. http://192.168.1.20:54321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
