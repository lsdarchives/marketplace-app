# Reference list of every environment variable the platform uses.
# Never commit real secrets.
#
# Mobile app variables (EXPO_PUBLIC_*) are read from apps/mobile/.env — see apps/mobile/.env.example.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose these to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

TYPESENSE_API_KEY=
MAPBOX_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
PAYFAST_MERCHANT_KEY=
PEACH_PAYMENTS_API_KEY=
OPENAI_API_KEY=
POSTHOG_API_KEY=
